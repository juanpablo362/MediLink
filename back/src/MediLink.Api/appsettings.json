{
  "Database": { "Provider": "Sqlite", "MigrateOnStartup": false },
  "ConnectionStrings": { "MediLink": "Data Source=App_Data/medilink.db" },
  "Jwt": { "Issuer": "MediLink.Api", "Audience": "MediLink.Web", "Minutes": 30 },
  "Storage": { "Path": "App_Data/results" },
  "Cors": { "Origins": ["http://localhost:4200"] },
  "Institution": { "TimeZone": "America/Hermosillo" },
  "Bootstrap": { "Enabled": false },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore.Database.Command": "Warning" } },
  "AllowedHosts": "localhost;127.0.0.1"
}
